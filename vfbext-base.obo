[Term]
id: VFB:10000005
name: cell cluster
is_a: BFO:0000004

[Term]
id: VFBext:0000004
name: expression pattern fragment
def: "An expression pattern that is some subset of another expression pattern due to additional genetic constraints (e.g. FLP recombination)." []
is_a: VFBext:0000100 ! expression pattern
property_value: terms:contributor https://orcid.org/0000-0002-7073-9172
property_value: terms:date "2018-03-04T10:55:59Z" xsd:dateTime

[Term]
id: VFBext:0000006
name: multi channel image
is_a: http://xmlns.com/foaf/0.1/image

[Term]
id: VFBext:0000007
name: template image
comment: A single channel image that is used as a template for image registration.
is_a: VFBext:0000014 ! channel
property_value: terms:contributor https://orcid.org/0000-0002-7073-9172
property_value: terms:date "2018-05-15T15:53:38Z" xsd:dateTime

[Term]
id: VFBext:0000010
name: intersectional expression pattern
def: "An expression pattern that depends upon the combined synthesis of multiple components, which drive expression only when combined within the same cell (e.g. split-GAL4)." []
is_a: VFBext:0000100 ! expression pattern
property_value: terms:contributor https://orcid.org/0000-0002-7073-9172
property_value: terms:date "2018-09-26T07:54:17Z" xsd:dateTime

[Term]
id: VFBext:0000014
name: channel
is_a: http://xmlns.com/foaf/0.1/image

[Term]
id: VFBext:0000100
name: expression pattern
def: "All cells within a single organism in which expression of some genetic entity occurs." []
is_a: FBbt:00007016
property_value: terms:contributor https://orcid.org/0000-0002-1373-1705
property_value: terms:date "2026-09-25T16:04:54Z" xsd:dateTime

[Typedef]
id: VFBext:0000001
name: has_channel

[Typedef]
id: VFBext:0000002
name: has_background_channel
is_a: VFBext:0000001 ! has_channel

[Typedef]
id: VFBext:0000003
name: has_signal_channel
is_a: VFBext:0000001 ! has_channel

[Typedef]
id: VFBext:0000008
name: has hemidriver
def: "A relationship between an interesctional expression pattern and one of the hemidrivers that contributes to driving its expression. For example, the split-GAL4 system drives expression using transgenes encoding a pair of interacting proteins, one with a GAL4 DNA binding domain and one with an transcription activation domain. In cells that co-express these two transgenes, interaction between the two proteins reconsitutes a transcription factor, driving expression from transgenes under the control of UAS enhancer/promoter elements." [PMID:17088209]
property_value: terms:contributor https://orcid.org/0000-0002-7073-9172
property_value: terms:date "2018-09-26T07:48:55Z" xsd:dateTime
domain: VFBext:0000010 ! intersectional expression pattern

[Typedef]
id: VFBext:0000009
name: has driver
def: "A relation that applies between a synthetic expression pattern and a transgene that drives it. For example, the GAL4 UAS system uses the yeast transcription factor GAL4 transgenes with specific expression patterns are used to drive expression of transgenes under the control of UAS promoter elements." [PMID:8223268, Wikipedia:GAL4/UAS_system]
property_value: terms:contributor https://orcid.org/0000-0002-7073-9172
property_value: terms:date "2018-09-26T07:49:10Z" xsd:dateTime
domain: VFBext:0000100 ! expression pattern
is_a: RO:0002292

